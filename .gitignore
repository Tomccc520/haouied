!data/migration_*.sql
!data/README.md

# 构建产物
dist/
build/
release/

# 上传文件
backend/uploads/*
!backend/uploads/.gitkeep
server/server/app/public/uploads/*
!server/server/app/public/uploads/.gitkeep
server/server/config/config.local.js
server/.module_backup/
server/.module_report/

# 导出文件
backend/exports/*
