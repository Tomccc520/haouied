# UIED-NAV Docker 生产环境变量模板
# 复制到站点 shared/uied-api.env 后填写，并执行 chmod 600。

NODE_ENV=production
EGG_SERVER_ENV=prod
UIED_SITE_ORIGIN=https://你的域名

# Linux 容器访问宝塔宿主机 MySQL/Redis 使用 host.docker.internal。
UIED_DB_HOST=host.docker.internal
UIED_DB_PORT=3306
UIED_DB_USER=请填写数据库账号
UIED_DB_PASSWORD='请填写数据库密码'
UIED_DB_NAME=请填写数据库名

UIED_REDIS_HOST=host.docker.internal
UIED_REDIS_PORT=6379
UIED_REDIS_PASSWORD=''
UIED_REDIS_DB=0

# 容器内固定持久化路径，宿主机目录由部署脚本挂载。
UIED_UPLOADS_ABS_DIR=/data/uploads

# 客户站禁止本地签发，不要填写授权中心签发密钥。
UIED_ENABLE_LOCAL_LICENSE_SIGN=false
UIED_REQUIRE_PAID_LICENSE_ACTIVATION=true
UIED_LICENSE_ACTIVATE_ENDPOINT=https://fsuied.com/api/license/detail
UIED_LICENSE_PROJECT_CODE=fsuied
UIED_LICENSE_ACTIVATE_TOKEN=''
