# UIED-NAV Docker Compose 路径配置模板
# 业务数据库和授权激活配置请填写站点 shared/uied-api.env，不要写入本文件。

UIED_VERSION=1.1.4
UIED_CONTAINER_NAME=uied-api
UIED_API_PORT=8002

# 以下路径建议改为服务器绝对路径。
UIED_API_ENV_FILE=/www/wwwroot/你的域名/shared/uied-api.env
UIED_UPLOADS_HOST_DIR=/www/wwwroot/你的域名/shared/uploads
UIED_LICENSES_HOST_DIR=/www/wwwroot/你的域名/shared/licenses
UIED_LOGS_HOST_DIR=/www/wwwroot/你的域名/shared/logs

# 中国大陆服务器可按需指定可访问的基础镜像和 npm 镜像。
UIED_NODE_IMAGE=node:20-bookworm-slim
UIED_NPM_REGISTRY=https://registry.npmmirror.com
