# UIED API Docker 环境变量配置
# 复制此文件为 .env 并修改

# 运行环境配置（生产必须）
NODE_ENV=production
EGG_SERVER_ENV=prod

# 商业授权配置（生产必须）
# 客户站必须为 false，禁止本地签发
UIED_ENABLE_LOCAL_LICENSE_SIGN=false
# 必须与 fsuied 授权中心签发端一致
UIED_LICENSE_SIGN_SECRET=replace-with-your-secret
# 建议与 UIED_LICENSE_SIGN_SECRET 保持一致
UIED_LICENSE_API_SIGN_SECRET=replace-with-your-secret

# 安全配置 - 必须修改！
JWT_SECRET=这里填64位随机字符串
PASSWORD_SALT=这里填32位随机字符串

# CORS 配置（你的域名）
CORS_ORIGINS=https://hao.uied.cn

# 前端地址（SEO 功能需要）
FRONTEND_URL=https://hao.uied.cn
