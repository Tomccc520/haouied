# UIED 导航系统 Nginx 配置模板（宝塔）
# 使用方式：
# 1. 将 __DOMAIN__ 替换为你的真实域名
# 2. 将 __SITE_ROOT__ 替换为你的站点目录（例如 /www/wwwroot/hao.uied.cn）
# 3. 将内容粘贴到宝塔对应站点的 Nginx 配置

server {
    listen 80;
    server_name __DOMAIN__;
    root __SITE_ROOT__/frontend;

    # HTTPS 请在宝塔站点 SSL 页面开启，由面板自动写入证书配置。

    # 上传限制
    client_max_body_size 100m;

    # 安全：禁止访问隐藏文件
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # 后端 API（Egg.js）
    location ~ ^/api(?:/|$) {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Egg 静态上传目录（持久化目录由 UIED_UPLOADS_ABS_DIR 指定）
    location ^~ /public/ {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        expires 30d;
        access_log off;
    }

    # 管理后台入口（Vue）
    location = /admin {
        return 301 /admin/;
    }

    # 后台构建资源均带内容哈希，可安全使用长期强缓存
    location ^~ /admin/assets/ {
        root __SITE_ROOT__;
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    location ^~ /admin/ {
        root __SITE_ROOT__;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # 官网前台（React）
    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # React 构建资源均带内容哈希，可安全使用长期强缓存
    location ^~ /static/ {
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    # 不带哈希的图片/字体使用普通缓存，升级后不会被 immutable 卡住
    location ~* \.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2)$ {
        expires 7d;
        access_log off;
        add_header Cache-Control "public";
    }

    access_log /www/wwwlogs/__DOMAIN__.log;
    error_log /www/wwwlogs/__DOMAIN__.error.log;
}
